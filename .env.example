# Copy to .env and change what you need. All values are optional.

# Host port that serves the clock (container port is always 8080).
CLOCK_PORT=6140

# Host address to bind. 127.0.0.1 = this machine only (default).
# Use 0.0.0.0 for your whole LAN, or a specific IP (for example a VPN address).
# The app has no login: expose it only on networks you trust.
CLOCK_BIND=127.0.0.1

# Optional: origins allowed to embed the compact clock (/?embed=1) in an iframe,
# separated by spaces, e.g. https://dashboard.example.com
CLOCK_EMBED_ORIGINS=
